# Local development template. Copy to .env — never commit .env.
DATABASE_URL=postgres://webmail:webmail@localhost:5434/webmail
PORT=8080

# Public base URL of the webmail (browser-facing; OIDC redirects use it).
APP_URL=http://localhost:5173

# 32-byte base64 master encryption key. Generate with:
#   bun apps/server/scripts/generate-master-key.ts
MASTER_KEY=

# Bootstrap/recovery mode: prints a temporary admin credential to the
# console and enables /api/setup and the /setup screen. Keep false in
# production; flip to true only for first setup or recovery.
BOOTSTRAP_MODE=false

SESSION_TTL_HOURS=12

# Base URL of the Stalwart JMAP server (internal network). When empty, the
# mail endpoints answer 503 mail_not_configured.
STALWART_URL=

# Some reverse-proxied JMAP servers advertise an internal or
# security-restricted origin in the session's apiUrl/uploadUrl/downloadUrl/
# eventSourceUrl instead of the one clients actually reach. When true,
# rewrite those URLs to STALWART_URL's origin, keeping path and query
# intact. Off by default — leave false unless your server needs it.
JMAP_FORCE_BASE=false

# AI features (summarize / draft-with-AI) are off by default and inert
# without both AI_ENABLED=true and AI_API_KEY set — see docs/ARCHITECTURE.md
# ("IA — funciones opt-in"). Any additional network-level restriction
# (egress, firewalling) is a deployment-specific choice outside this
# software's contract.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Rotación de la clave maestra (#172) ---
# Un despliegue existente que solo tenga MASTER_KEY es versión 1 sin historial
# y sigue funcionando sin tocar nada. Al rotar: subir MASTER_KEY_VERSION, poner
# la clave nueva en MASTER_KEY y listar la anterior en MASTER_KEY_PREVIOUS como
# "version:clave" (varias separadas por coma). El servidor NO arranca si alguna
# fila guarda una key_version para la que no hay clave.
MASTER_KEY_VERSION=1
MASTER_KEY_PREVIOUS=

# --- Plazos de salida en milisegundos (#165) ---
# Opcionales; estos son los valores que el servidor ya usa por defecto. Son
# distintos a propósito: un techo holgado para una generación de IA no es techo
# para un listado de buzón.
STALWART_TIMEOUT_MS=10000
AI_TIMEOUT_MS=60000
OIDC_TIMEOUT_MS=10000
