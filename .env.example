# Local development template. Copy to .env — never commit .env.
DATABASE_URL=postgres://webmail:webmail@localhost:5434/webmail
PORT=8080

# Public base URL of the webmail (browser-facing; OIDC redirects use it).
APP_URL=http://localhost:5173

# 32-byte base64 master encryption key. Generate with:
#   bun apps/server/scripts/generate-master-key.ts
MASTER_KEY=

# Bootstrap/recovery mode: enables the emergency login and /api/setup (plus
# the /setup screen). Keep false in production; flip to true only for first
# setup or recovery.
BOOTSTRAP_MODE=false

# Break-glass credential (#235). REQUIRED whenever BOOTSTRAP_MODE=true — the
# server refuses to boot without it — and ignored otherwise. It is the
# emergency login password AND the /setup token, so it grants admin: keep it
# in the same secret store as MASTER_KEY and remove it when you set
# BOOTSTRAP_MODE back to false. At least 24 characters; generate one with
#   openssl rand -base64 24
# The server used to invent this password at boot and print it to the log
# stream in plaintext, which put a working admin credential in `docker logs`
# and in every aggregator collecting them. It is never logged now.
BOOTSTRAP_PASSWORD=

# Note: /api/setup also closes itself for good once setup has finished — an
# active admin exists and SSO is configured — even if BOOTSTRAP_MODE is left
# on by mistake (#234). Recovery after that point goes through the emergency
# login and the admin console, not the setup wizard.

SESSION_TTL_HOURS=12

# --- Proveedor JMAP (#33/#34/#35, diseño #188) ---
# Base URL del servidor JMAP (Stalwart en nuestros despliegues; el protocolo es
# RFC 8620 y este cliente también, de ahí el nombre por ROL). Vacío = los
# endpoints de correo contestan 503 mail_not_configured.
#
# Debe ser el camino MÁS DIRECTO hasta el proveedor (red interna, nombre de
# servicio, link privado), nunca el borde TLS público: el navegador no habla
# nunca con el proveedor y el SSE es de larga duración, así que pasar por un CDN
# solo añade latencia y topes de duración. Ver docs/PRODUCCION.md.
JMAP_URL=

# Qué hacer con las URLs que el proveedor anuncia en su sesión JMAP
# (apiUrl/uploadUrl/downloadUrl/eventSourceUrl):
#   rewrite (por defecto) — reescribe SOLO el origen (esquema+host+puerto) al de
#                           JMAP_URL, conservando ruta, query y los
#                           marcadores {accountId}/{blobId}. Correcto en casi
#                           todo despliegue con proxy.
#   trust                 — usarlas tal cual. Solo para el caso raro de host
#                           partido (blobs/descargas en otro origen alcanzable).
# No existe "auto": sondear y adivinar se evaluó y se descartó (#188).
JMAP_URL_MODE=rewrite

# Cómo se le presenta la credencial de buzón al proveedor:
#   basic (por defecto) — HTTP Basic con email:contraseña (Stalwart y casi todo
#                         servidor autoalojado).
#   bearer              — Authorization: Bearer <credencial>, para proveedores
#                         con token/OAuth (Fastmail y similares). La credencial
#                         de buzón cifrada ES el token; el modelo de dos
#                         contraseñas no cambia.
JMAP_AUTH_MODE=basic

# authserv-id (#152, RFC 8601 §5). Es el primer token que TU MTA receptor
# (Stalwart en nuestros despliegues) escribe en la cabecera
# Authentication-Results que añade — normalmente el hostname del servidor de
# correo (p. ej. mail.cefiro.test). Solo se confía en la cabecera cuya
# authserv-id coincide con este valor para pintar la tilde de "remitente
# verificado"; cualquier otra la puede falsificar el remitente y se ignora.
#
# Vacío (por defecto) = a prueba de fallos: NINGUNA cabecera se considera de
# confianza, así que todos los veredictos quedan en "unknown" y ningún mensaje
# muestra la tilde. Mejor no insignia que una falsificable. El servidor avisa en
# cada arranque mientras esté sin fijar. No se puede adivinar: fijar uno
# equivocado confiaría en la cabecera equivocada. Ver docs/OPERATIONS.md.
JMAP_AUTHSERV_ID=

# TLS: no hay perilla de CA propia y NO hay ningún "insecure". Para un
# proveedor con certificado privado o CA interna, apunte NODE_EXTRA_CA_CERTS al
# bundle PEM — Bun y Node ya lo respetan:
#   NODE_EXTRA_CA_CERTS=/etc/ssl/certs/mi-ca-interna.pem
# En el salto interno entre contenedores basta con http:// y no hay nada que
# configurar.

# AI features (summarize / draft-with-AI) are off by default and inert
# without both AI_ENABLED=true and AI_API_KEY set — see docs/ARCHITECTURE.md
# ("IA — funciones opt-in"). Any additional network-level restriction
# (egress, firewalling) is a deployment-specific choice outside this
# software's contract.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-4-8
# Per-task model overrides (#310), both OPTIONAL. When unset each falls back to
# AI_MODEL. A cheaper/smaller model summarizes well; the draft needs a stronger
# one — set them independently to balance cost against quality.
# AI_MODEL_SUMMARIZE=claude-haiku-4
# AI_MODEL_DRAFT=claude-opus-4-8

# --- Notificaciones push (Web Push / VAPID, #294) ---
# Desactivadas por defecto: sin las TRES variables el servidor no ofrece push
# (buildPushClient devuelve null, /api/push/status responde enabled:false y la
# opción no aparece en Ajustes). Son claves propias, sin cuenta ni Firebase.
# Genera el par con:
#   bunx web-push generate-vapid-keys
# VAPID_SUBJECT es un mailto: (o una URL https) de contacto del operador. La
# clave pública se le entrega al navegador para suscribirse; la privada firma
# el JWT VAPID y nunca sale del servidor. Un trío a medias se trata como
# "desactivado" (con aviso en el arranque), no impide arrancar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Rotación de la clave maestra (#172) ---
# Un despliegue existente que solo tenga MASTER_KEY es versión 1 sin historial
# y sigue funcionando sin tocar nada. Al rotar: subir MASTER_KEY_VERSION, poner
# la clave nueva en MASTER_KEY y listar la anterior en MASTER_KEY_PREVIOUS como
# "version:clave" (varias separadas por coma). El servidor NO arranca si alguna
# fila guarda una key_version para la que no hay clave.
MASTER_KEY_VERSION=1
MASTER_KEY_PREVIOUS=

# --- Plazos de salida en milisegundos (#165) ---
# Opcionales; estos son los valores que el servidor ya usa por defecto. Son
# distintos a propósito: un techo holgado para una generación de IA no es techo
# para un listado de buzón.
JMAP_TIMEOUT_MS=10000
AI_TIMEOUT_MS=60000
OIDC_TIMEOUT_MS=10000

# --- Nombres retirados (#33/#34) ---
# STALWART_URL        → JMAP_URL          (el viejo se sigue leyendo, con aviso)
# STALWART_TIMEOUT_MS → JMAP_TIMEOUT_MS   (el viejo se sigue leyendo, con aviso)
# JMAP_FORCE_BASE     → JMAP_URL_MODE     (RETIRADO, se ignora: era un booleano
#   cuyo valor por defecto era el contrario del modo por defecto de ahora.
#   JMAP_FORCE_BASE=true ≡ JMAP_URL_MODE=rewrite; =false ≡ =trust.)
# El servidor avisa en cada arranque mientras queden nombres viejos.

# ─────────────────────────────────────────────────────────────
# Perillas añadidas en las olas v8-v10 (issue #210)
# ─────────────────────────────────────────────────────────────

# Entorno. En "production" se fuerzan las cookies Secure (#196) y se
# sirven los estáticos del frontend. Fuera de development/test se exige
# una MASTER_KEY fuerte (#223). Default: development
NODE_ENV=production

# Nivel de log: debug | info | warn | error. Default: info  (#219)
# LOG_LEVEL=info

# Raíz de los estáticos del frontend. Solo se lee con NODE_ENV=production.
# Default: ../web/dist
# STATIC_DIR=../web/dist

# ── Límite de cuerpo de petición (#195) ──
# Tope global en bytes. 2 MiB admite una imagen inline al máximo más el
# sobre. POST /api/mail/blobs queda exento. Default: 2097152
# MAX_BODY_BYTES=2097152

# ── Conexión a Postgres (#191) ──
# DB_POOL_MAX=10                 # tamaño del pool
# DB_CONNECT_TIMEOUT_S=10        # plazo del handshake (s)
# DB_IDLE_TIMEOUT_S=300          # cierre de conexiones ociosas (s)
# DB_STATEMENT_TIMEOUT_MS=30000  # cancela una query que se pasa (ms)

# ── Apagado ordenado (#193) ──
# SHUTDOWN_GRACE_MS=15000        # drenar peticiones en vuelo
# SHUTDOWN_DB_TIMEOUT_MS=5000    # cerrar el pool

# ── Proxies de confianza (#238) ──
# Cuántos proxies AÑADEN su salto a X-Forwarded-For entre internet y este
# proceso. La IP del cliente se lee contando ESE número de entradas desde la
# DERECHA, que es el extremo que el cliente no puede alcanzar: con 1 y un nginx
# usando $proxy_add_x_forwarded_for, mande el cliente lo que mande, la última
# entrada la escribió nuestro proxy.
#
# De ello dependen los CINCO límites por IP (login OIDC, login de emergencia,
# /api/setup, /api/health y /metrics) y la columna `ip` de la auditoría. Un
# valor MAYOR que la cadena real hace que todo caiga en un cubo compartido
# (fail-safe); uno MENOR devuelve una entrada que eligió el cliente — contar los
# saltos reales es lo único que hay que hacer bien aquí.
#
# 0 = no confiar en la cabecera. Correcto si el proceso está expuesto
# directamente, al precio de que los límites pasen a ser globales.
# Default: 1
# TRUSTED_PROXY_HOPS=1

# ── Métricas (#208) ──
# Token de scrape para /metrics. SIN él el endpoint NO se registra
# (no responde 401, simplemente no existe).
# METRICS_TOKEN=

# ── IA ──
# Obligatoria si AI_PROVIDER=openai-compat; sin ella la IA se desactiva.
# AI_BASE_URL=https://tu-proveedor/v1

# ── dbSOS (#189) — las lee scripts/db-*.sh, NO el servidor ──
# DBSOS_KEY_FILE=/run/secrets/dbsos.key   # clave AES, FUERA de DBSOS_DIR
# DBSOS_DIR=/var/backups/cefiro
# DBSOS_RETENTION_DAYS=7
# DBSOS_JOBS=4                             # paralelismo del restore
# DBSOS_YES=1                              # solo automatización
# DBSOS_STATUS_FILE=/var/backups/cefiro/dbsos-status.prom  # estado p/ monitoreo (#208)