# Shell scripts must keep LF endings — they run inside Linux containers
# where CRLF breaks the interpreter.
*.sh text eol=lf

# Stalwart RocksDB seed store: several sidecar files (CURRENT, LOG,
# OPTIONS-*) look text-like to git's heuristics but are read byte-exact by
# RocksDB. Never let line-ending normalization (core.autocrlf) touch them.
e2e/stalwart/seed/** -text
